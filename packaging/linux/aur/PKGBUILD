# Maintainer: LinkSpec contributors
pkgname=linkspec-bin
pkgver=0.9.2
pkgrel=1
pkgdesc="USB-C / Thunderbolt / USB4 diagnosis: which link limits the connection"
arch=('x86_64' 'aarch64')
url="https://github.com/itsh-neumeier/linkspec"
license=('MIT')
depends=('libxkbcommon' 'libxkbcommon-x11' 'fontconfig' 'dbus')
provides=('linkspec')
conflicts=('linkspec')
source_x86_64=("$url/releases/download/v$pkgver/linkspec-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/linkspec-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP') # maintainer: fill from SHA256SUMS
sha256sums_aarch64=('SKIP')

package() {
  cd "linkspec-$pkgver-linux-$CARCH"
  install -Dm755 linkspec "$pkgdir/usr/bin/linkspec"
  install -Dm755 linkspec-app "$pkgdir/usr/bin/linkspec-app"
  touch "$pkgdir/usr/bin/linkspec-packaged"
  install -Dm644 linkspec.desktop "$pkgdir/usr/share/applications/linkspec.desktop"
  install -Dm644 linkspec.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/linkspec.png"
  install -Dm644 60-linkspec.rules "$pkgdir/usr/share/linkspec/60-linkspec.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES"
}
